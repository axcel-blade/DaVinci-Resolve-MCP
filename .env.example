# DaVinci Resolve MCP settings. Copy to .env in the repo root (or set in your MCP client's "env" block, which wins).
# Transport for MCP clients: stdio (Claude Desktop, VS Code, Cursor) or http (ChatGPT via a tunnel, remote clients)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3334
# Required for http transport when the host is not loopback. Generate: pwsh scripts/new-token.ps1
MCP_AUTH_TOKEN=
# Alternative for connector UIs that cannot send headers: serve at /mcp/<secret> (>= 24 URL-safe chars)
MCP_SECRET_PATH=
# Expose only some tool categories (comma list), e.g. application,projects,media,timeline,editing,rendering
MCP_TOOL_CATEGORIES=

# DaVinci Resolve bridge: python (the official scripting API) or mock (tests/demos, no DaVinci Resolve)
RESOLVE_ADAPTER=python
# Install folder, scripting API folder and fusionscript library (auto-detected when empty; scripts\install.ps1 fills them)
RESOLVE_INSTALL_DIR=
RESOLVE_SCRIPT_API=
RESOLVE_SCRIPT_LIB=
# 64-bit Python used for the scripting bridge
RESOLVE_PYTHON=python
# Per-call timeout, and the longer timeout for renders and background jobs
RESOLVE_TIMEOUT_MS=60000
RESOLVE_RENDER_TIMEOUT_MS=14400000
# Launch DaVinci Resolve on the first tool call if it is not running
RESOLVE_AUTO_LAUNCH=false

# Output folders (renders, backups, generated LUTs)
OUTPUT_DIR=output
BACKUP_DIR=output/backups
LUT_DIR=output/luts
# Semicolon-separated directories the server may write to. Defaults to output, Videos, Documents, Desktop and TEMP
ALLOWED_WRITE_PATHS=
# Semicolon-separated directories the server may read (imports). Empty = any local path
ALLOWED_READ_PATHS=

# Destructive tools need confirm: true, and back up the project first
REQUIRE_CONFIRMATION=true
BACKUP_BEFORE_DESTRUCTIVE=true

# FFmpeg (media analysis, loudness, silence/scene detection, render verification)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

LOG_LEVEL=info
LOG_DIR=logs

# Optional external AI provider, OpenAI-compatible (never committed; only used when set)
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy
