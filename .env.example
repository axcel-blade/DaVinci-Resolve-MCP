# DaVinci Resolve MCP settings. Copy to .env (scripts\install.ps1 does this and fills the paths).
# Values set in the MCP client's "env" block override this file. Full reference: docs/CONFIGURATION.md

# ---- Transport: stdio (Claude Desktop / local clients) or http (ChatGPT connectors, remote clients)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3334
# Required whenever MCP_HTTP_HOST is not loopback. Generate with scripts\new-token.ps1
MCP_AUTH_TOKEN=
# Optional secret path (/mcp/<secret>) for clients that cannot send an Authorization header
MCP_SECRET_PATH=
# Optional: expose only some tool categories (comma list), e.g. application,projects,media,timeline,editing,rendering
MCP_TOOL_CATEGORIES=

# ---- DaVinci Resolve (auto-detected when empty)
RESOLVE_INSTALL_DIR=
RESOLVE_SCRIPT_API=
RESOLVE_SCRIPT_LIB=
# 64-bit Python used for the scripting bridge
RESOLVE_PYTHON=python
RESOLVE_TIMEOUT_MS=60000
RESOLVE_RENDER_TIMEOUT_MS=14400000
# Launch Resolve automatically when a tool needs it and it is not running
RESOLVE_AUTO_LAUNCH=false

# ---- Files
OUTPUT_DIR=output
BACKUP_DIR=output/backups
LUT_DIR=output/luts
# Semicolon-separated folders the server may WRITE to (exports, renders, backups). Default: output, Videos, Documents, Desktop, TEMP
ALLOWED_WRITE_PATHS=
# Semicolon-separated folders the server may READ (imports). Empty = any local path
ALLOWED_READ_PATHS=

# ---- Safety
REQUIRE_CONFIRMATION=true
BACKUP_BEFORE_DESTRUCTIVE=true

# ---- Optional external AI provider (OpenAI-compatible). Never commit real keys.
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# ---- Optional FFmpeg (media analysis, loudness, silence/scene detection, render verification)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

LOG_LEVEL=info
LOG_DIR=logs
