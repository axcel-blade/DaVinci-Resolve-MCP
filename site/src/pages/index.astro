---
import Layout from "../layouts/Layout.astro";
import { href, REPO, toolCount, VERSION } from "../lib/docs";

const site = (Astro.site?.href ?? "").replace(/\/$/, "") + import.meta.env.BASE_URL.replace(/\/$/, "");
const win = `irm ${site}/install.ps1 | iex`;
const mac = `curl -fsSL ${site}/install.sh | bash`;
const tools = toolCount();
---
<Layout title="DaVinci Resolve MCP">
  <section class="hero">
    <h1>Edit in DaVinci Resolve by describing it.</h1>
    <p class="lede">
      An MCP server that lets Claude, ChatGPT and other AI assistants drive DaVinci Resolve. It creates projects, imports
      media, builds and edits timelines, grades, mixes audio, adds titles and subtitles, and renders deliverables.
    </p>
    <div class="cta">
      <a class="btn primary" href="#install">Install</a>
      <a class="btn" href={href("/docs/tools/")}>Browse {tools} tools</a>
      <a class="btn" href={REPO}>View on GitHub</a>
    </div>
  </section>

  <section class="section" id="install" aria-labelledby="install-h">
    <h2 id="install-h">Install</h2>
    <div class="install">
      <div class="card">
        <h3>Windows</h3>
        <p>PowerShell. Installs to <code>%LOCALAPPDATA%\DaVinciResolveMCP</code> and registers it with your AI clients.</p>
        <div class="cmd"><code>{win}</code><button type="button" data-copy={win}>Copy</button></div>
      </div>
      <div class="card">
        <h3>macOS</h3>
        <p>Terminal. Installs to <code>~/Library/Application Support/DaVinciResolveMCP</code> and registers it with your AI clients.</p>
        <div class="cmd"><code>{mac}</code><button type="button" data-copy={mac}>Copy</button></div>
      </div>
    </div>
    <p class="note">
      Configures every MCP client it finds: Claude Desktop, Claude Code, Cursor, Windsurf, VS Code (Copilot), Cline, Roo Code,
      Gemini CLI and Codex. Existing configs are merged, with a backup. <a href={href("/docs/configuration/#mcp-clients-the-installers-configure")}>Details</a>.
    </p>
    <p class="note">
      Needs Node.js 20+, Python 3 (64-bit) and DaVinci Resolve 18 or newer with external scripting set to Local. Read a script before piping it to a shell: <a href={href("/install.ps1")}>install.ps1</a>,
      <a href={href("/install.sh")}>install.sh</a>. Manual setup, ChatGPT and remote HTTP: <a href={href("/docs/installation/")}>installation guide</a>.
    </p>
  </section>

  <section class="section" aria-labelledby="what-h">
    <h2 id="what-h">What it does</h2>
    <div class="features">
      <div class="card"><div class="stat">{tools}</div><p>MCP tools: projects, media pool, timelines, editing, effects, speed, titles, subtitles, Fusion, color, Fairlight audio and rendering.</p></div>
      <div class="card"><div class="stat">Workflows</div><p>YouTube, social, documentary, cinematic and advertisement workflows plan a full edit you can dry-run and review before anything changes.</p></div>
      <div class="card"><div class="stat">Native</div><p>Everything is a real Resolve project, timeline and render job, not a flattened export, so you can keep editing by hand.</p></div>
      <div class="card"><div class="stat">Checked</div><p>Results come from DaVinci Resolve itself. Destructive actions need confirmation and a backup, and file access is limited to folders you allow.</p></div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <h2 id="how-h">How it works</h2>
    <ol class="flow">
      <li>You ask your assistant for an edit.</li>
      <li>The server plans it and validates the arguments.</li>
      <li>DaVinci Resolve runs it through its official Python scripting API.</li>
      <li>The assistant inspects the timeline or render and revises.</li>
    </ol>
    <p class="note">Details: <a href={href("/docs/architecture/")}>architecture</a>, <a href={href("/docs/examples/")}>example prompts</a>, <a href={href("/docs/limitations/")}>limitations</a>. Current release: <a href={`${REPO}/releases/latest`}>v{VERSION}</a>.</p>
  </section>

  <script>
    for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          btn.textContent = "Copied";
        } catch {
          btn.textContent = "Select it";
        }
        setTimeout(() => (btn.textContent = "Copy"), 1600);
      });
    }
  </script>
</Layout>
