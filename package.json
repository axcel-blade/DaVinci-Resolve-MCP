{
  "name": "davinci-resolve-mcp",
  "version": "1.0.0",
  "description": "DaVinci Resolve MCP server: control DaVinci Resolve (projects, media, timelines, Fusion, color, Fairlight, rendering) from Claude, ChatGPT and other MCP clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "davinci-resolve-mcp": "dist/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "test": "vitest run --project default",
    "test:unit": "vitest run --project default tests/unit",
    "test:integration": "vitest run --project default tests/integration",
    "test:live": "vitest run --project e2e",
    "test:report": "node tests/integration/run-integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:tools": "node scripts/gen-docs.mjs",
    "test:watch": "vitest --project default",
    "lint": "eslint .",
    "pack:release": "node scripts/pack-release.mjs",
    "smoke": "node scripts/smoke-install.mjs",
    "test:security": "vitest run --project default tests/security"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^22.20.7",
    "eslint": "9.39.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^5.1.2"
  }
}
